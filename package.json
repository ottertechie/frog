{
  "name": "frog",
  "private": true,
  "version": "0.1.0",
  "description": "Frog: local-first multi-persona desktop assistant",
  "workspaces": [
    "app/frontend",
    "app/backend"
  ],
  "scripts": {
    "dev": "bash scripts/dev.sh",
    "dev:frontend": "npm --workspace app/frontend run dev",
    "dev:backend": "npm --workspace app/backend run dev",
    "dev:tauri": "npm --workspace app/frontend run tauri dev",
    "build": "bash scripts/build.sh",
    "typecheck": "npm --workspaces run typecheck",
    "lint": "npm --workspaces run lint",
    "check:ollama": "bash scripts/check-ollama.sh"
  }
}
